# -----------------------------------
# Application
# -----------------------------------
APP_NAME=AI Powered Solar & Wind Deployment Intelligence Platform
APP_VERSION=1.0.0
DEBUG=True

HOST=127.0.0.1
PORT=8000

# -----------------------------------
# PostgreSQL
# -----------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/solarwind_db

# -----------------------------------
# JWT
# -----------------------------------
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

OPENWEATHER_API_KEY=YOUR_API_KEY

MAX_RETRIES=3
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO

RAW_DATASET_PATH=datasets/raw

INTERIM_DATASET_PATH=datasets/interim

PROCESSED_DATASET_PATH=datasets/processed

ML_PREDICTION_ENABLED=false
SOLAR_ML_MODEL_VERSION=v0.1-physics-informed
WIND_ML_MODEL_VERSION=v0.1-physics-informed

# Application Configuration
APP_NAME=Solar & Wind Deployment Intelligence Platform
API_PREFIX=/api
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/renewables_platform

# MongoDB (if needed)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=renewables

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# External APIs (add your actual keys)
NASA_POWER_API=
OPENWEATHER_API_KEY=
OPENSTREETMAP_API=
GLOBAL_WIND_ATLAS_API=
SRTM_API_KEY=
SENTINEL_API_KEY=

# Email (if needed)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=

# Redis (if needed for caching)
REDIS_URL=redis://localhost:6379/0